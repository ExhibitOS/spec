{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exhibitos.github.io/spec/workspace-furnishing/v3/placements.schema.json",
  "title": "Workspace furnishing visual placements candidate v3",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 3
    },
    "furnishings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "https://exhibitos.github.io/spec/workspace-furnishing/v3/furnishing.schema.json"
      }
    },
    "placements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "roomId": {
            "$ref": "#/$defs/id"
          },
          "furnishingId": {
            "$ref": "#/$defs/id"
          },
          "furnishingVersion": {
            "const": 1
          },
          "position": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": -10000,
              "maximum": 10000
            }
          },
          "yaw": {
            "type": "number",
            "minimum": -3.141592653589793,
            "maximum": 3.141592653589793
          },
          "scale": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 4
          }
        },
        "required": [
          "id",
          "roomId",
          "furnishingId",
          "furnishingVersion",
          "position",
          "yaw",
          "scale"
        ]
      }
    }
  },
  "required": [
    "version",
    "furnishings",
    "placements"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-8][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
    }
  }
}
