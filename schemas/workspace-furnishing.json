{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exhibitos.github.io/spec/workspace-furnishing/v1/furnishing.schema.json",
  "title": "Workspace furnishing descriptor candidate v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-8][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$" },
    "version": { "const": 1 },
    "kind": { "enum": ["pedestal", "bench"] },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "rights": { "$ref": "https://exhibitos.github.io/spec/oes/v1/1.0.0-draft.1/artwork.schema.json#/$defs/rights" },
    "provenance": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "model": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "mime": { "const": "model/gltf-binary" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 33554432 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "required": ["mime", "bytes", "sha256"]
    }
  },
  "required": ["id", "version", "kind", "name", "rights", "provenance", "model"]
}
