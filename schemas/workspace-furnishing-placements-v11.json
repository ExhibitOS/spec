{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exhibitos.github.io/spec/workspace-furnishing/v11/placements.schema.json",
  "title": "Workspace furnishing visual placements candidate v11",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 11
    },
    "furnishings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "https://exhibitos.github.io/spec/workspace-furnishing/v11/furnishing.schema.json"
      }
    },
    "placements": {
      "type": "array",
      "minItems": 0,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "roomId": {
            "$ref": "#/$defs/id"
          },
          "furnishingId": {
            "$ref": "#/$defs/id"
          },
          "furnishingVersion": {
            "const": 1
          },
          "position": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": -10000,
              "maximum": 10000
            }
          },
          "yaw": {
            "type": "number",
            "minimum": -3.141592653589793,
            "maximum": 3.141592653589793
          },
          "scale": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 4
          }
        },
        "required": [
          "id",
          "roomId",
          "furnishingId",
          "furnishingVersion",
          "position",
          "yaw",
          "scale"
        ]
      }
    },
    "frameAttachments": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "placementId": {
            "$ref": "#/$defs/id"
          },
          "artworkRevisionId": {
            "$ref": "#/$defs/id"
          },
          "assetId": {
            "$ref": "#/$defs/id"
          },
          "furnishingId": {
            "$ref": "#/$defs/id"
          },
          "furnishingVersion": {
            "const": 1
          },
          "modelSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "imageFit": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "version": {
                "const": 1
              },
              "profile": {
                "const": "contain-contact-v1"
              },
              "sourceSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "pixelWidth": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8192
              },
              "pixelHeight": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8192
              }
            },
            "required": [
              "version",
              "profile",
              "sourceSha256",
              "pixelWidth",
              "pixelHeight"
            ]
          }
        },
        "required": [
          "placementId",
          "artworkRevisionId",
          "assetId",
          "furnishingId",
          "furnishingVersion",
          "modelSha256"
        ]
      }
    },
    "openingAttachments": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "openingId": {
            "$ref": "#/$defs/id"
          },
          "furnishingId": {
            "$ref": "#/$defs/id"
          },
          "furnishingVersion": {
            "const": 1
          },
          "modelSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "openingId",
          "furnishingId",
          "furnishingVersion",
          "modelSha256"
        ]
      },
      "minItems": 0
    },
    "ceilingAttachments": {
      "type": "array",
      "minItems": 0,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "placementId": {
            "$ref": "#/$defs/id"
          },
          "surfaceId": {
            "$ref": "#/$defs/id"
          },
          "anchor": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": -10000,
              "maximum": 10000
            }
          },
          "yaw": {
            "type": "number",
            "minimum": -3.141592653589793,
            "maximum": 3.141592653589793
          },
          "gap": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.1
          }
        },
        "required": [
          "placementId",
          "surfaceId",
          "anchor",
          "yaw",
          "gap"
        ]
      }
    }
  },
  "required": [
    "version",
    "furnishings",
    "placements",
    "frameAttachments",
    "openingAttachments",
    "ceilingAttachments"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-8][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
    }
  }
}
