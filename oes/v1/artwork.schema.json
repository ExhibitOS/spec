{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exhibitos.github.io/spec/oes/v1/1.0.0-draft.1/artwork.schema.json",
  "title": "OES Artwork 1.0.0-draft.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0-draft.1"
    },
    "kind": {
      "const": "artwork"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "revisionId": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "artist": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "description": {
          "type": "string",
          "maxLength": 16384
        },
        "medium": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "title",
        "artist"
      ]
    },
    "artworkType": {
      "enum": [
        "sculpture",
        "image"
      ]
    },
    "units": {
      "const": "meter"
    },
    "coordinates": {
      "const": "right-handed-y-up"
    },
    "dimensions": {
      "$ref": "#/$defs/dimensions"
    },
    "transform": {
      "$ref": "#/$defs/transform"
    },
    "primaryAssetId": {
      "type": "string",
      "format": "uuid"
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      },
      "minItems": 1,
      "maxItems": 64
    },
    "rights": {
      "$ref": "#/$defs/rights"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "extensions": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+\\/[A-Za-z0-9_-]+$"
      },
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "revisionId",
    "revision",
    "createdAt",
    "metadata",
    "artworkType",
    "units",
    "coordinates",
    "dimensions",
    "transform",
    "primaryAssetId",
    "assets",
    "rights",
    "provenance"
  ],
  "$defs": {
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "depth": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "weightKg": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "width",
        "height"
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "path": {
          "type": "string",
          "maxLength": 240,
          "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9_.-]*/)*[A-Za-z0-9_-][A-Za-z0-9_.-]*$"
        },
        "role": {
          "enum": [
            "model",
            "image",
            "preview"
          ]
        },
        "mime": {
          "enum": [
            "model/gltf-binary",
            "image/png",
            "image/jpeg",
            "image/webp"
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 104857600
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "path",
        "role",
        "mime",
        "bytes",
        "sha256"
      ]
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "holder": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "ownership": {
          "enum": [
            "owner",
            "authorized-licensee"
          ]
        },
        "licenseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "licenseText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "display": {
              "type": "boolean"
            },
            "download": {
              "type": "boolean"
            },
            "export": {
              "type": "boolean"
            },
            "commercial": {
              "type": "boolean"
            }
          },
          "required": [
            "display",
            "download",
            "export",
            "commercial"
          ]
        },
        "creditLine": {
          "type": "string",
          "maxLength": 2048
        },
        "validFrom": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "holder",
        "ownership",
        "permissions",
        "creditLine"
      ],
      "anyOf": [
        {
          "properties": {
            "licenseId": {}
          },
          "required": [
            "licenseId"
          ]
        },
        {
          "properties": {
            "licenseText": {}
          },
          "required": [
            "licenseText"
          ]
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "type": {
                "enum": [
                  "created",
                  "digitized",
                  "converted",
                  "edited",
                  "exhibited",
                  "rights-recorded"
                ]
              },
              "at": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "tool": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "required": [
                  "name",
                  "version"
                ]
              },
              "sourceAssetIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid"
                },
                "minItems": 1,
                "maxItems": 64
              }
            },
            "required": [
              "id",
              "type",
              "at",
              "description"
            ]
          },
          "minItems": 1,
          "maxItems": 1024
        },
        "scaleConversion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sourceUnit": {
              "enum": [
                "meter",
                "centimeter",
                "millimeter",
                "inch",
                "foot"
              ]
            },
            "multiplierToMeters": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "appliedToAssetIds": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "minItems": 1,
              "maxItems": 64
            },
            "bakedIntoGeometry": {
              "const": true
            }
          },
          "required": [
            "sourceUnit",
            "multiplierToMeters",
            "appliedToAssetIds",
            "bakedIntoGeometry"
          ]
        },
        "authorship": {
          "enum": [
            "human-authored",
            "ai-assisted",
            "ai-generated",
            "synthetic"
          ]
        }
      },
      "required": [
        "events",
        "authorship"
      ]
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "position": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "rotation": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "minItems": 4,
          "maxItems": 4
        },
        "scale": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": [
        "position",
        "rotation",
        "scale"
      ]
    }
  }
}
