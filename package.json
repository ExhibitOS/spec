{
  "name": "@exhibitos/spec",
  "version": "0.1.0-draft.10",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "fixtures:generate": "node scripts/generate-fixtures.mjs",
    "fixtures:check": "node scripts/check-fixtures.mjs",
    "test": "node --test scripts/fixtures.test.mjs validators/artwork.test.mjs validators/exhibition.test.mjs validators/package.test.mjs conformance/distribution.test.mjs validators/oex-media.test.mjs validators/spatial-scripting.test.mjs validators/cli-ux.test.mjs providers/providers.test.mjs validators/space-still.test.mjs validators/floor-resources.test.mjs validators/furnishings.test.mjs validators/surface-material-resources.test.mjs validators/footstep-resources.test.mjs",
    "check": "npm run types:check && npm run fixtures:check && npm test && npm run conformance && npm run conformance:providers",
    "validate:artwork": "node validators/artwork-cli.mjs",
    "validate:exhibition": "node validators/exhibition-cli.mjs",
    "validate:package": "node validators/package-cli.mjs",
    "fixtures:package": "node scripts/generate-oex-example.mjs",
    "build": "node scripts/generate-types.mjs && node scripts/generate-space-still-validator.mjs",
    "types:check": "node scripts/generate-types.mjs --check && node scripts/generate-space-still-validator.mjs --check && tsc -p conformance/tsconfig.json",
    "artifact:build": "npm run build && node scripts/build-artifact.mjs",
    "conformance": "node conformance/cli.mjs",
    "artifact:check": "npm run artifact:build && node scripts/check-artifact.mjs",
    "conformance:providers": "node providers/conformance.mjs"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "gltf-validator": "2.0.0-dev.3.10"
  },
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./index.mjs"
    },
    "./package.json": "./package.json",
    "./schemas/artwork.json": "./schemas/artwork.json",
    "./schemas/exhibition.json": "./schemas/exhibition.json",
    "./schemas/lifecycle.json": "./schemas/lifecycle.json",
    "./schemas/oex.json": "./schemas/oex.json",
    "./schemas/oed.json": "./schemas/oed.json",
    "./schemas/oex-media.json": "./schemas/oex-media.json",
    "./schemas/spatial-scripting.json": "./schemas/spatial-scripting.json",
    "./providers": {
      "types": "./types/providers.d.ts",
      "import": "./providers/index.mjs"
    },
    "./providers/examples": {
      "types": "./types/provider-examples.d.ts",
      "import": "./providers/examples.mjs"
    },
    "./space-still": {
      "types": "./types/space-still.d.ts",
      "import": "./validators/space-still.mjs"
    },
    "./schemas/space-still.json": "./schemas/space-still.json",
    "./schemas/oex-space-still.json": "./schemas/oex-space-still.json",
    "./floor-resources": {
      "types": "./types/floor-resources.d.ts",
      "import": "./validators/floor-resources.mjs"
    },
    "./schemas/oex-floor-resources.json": "./schemas/oex-floor-resources.json",
    "./schemas/oex-furnishing.json": "./schemas/oex-furnishing.json",
    "./surface-material-resources": {
      "types": "./types/surface-material-resources.d.ts",
      "import": "./validators/surface-material-resources.mjs"
    },
    "./schemas/oex-surface-materials.json": "./schemas/oex-surface-materials.json",
    "./footstep-resources": {
      "types": "./types/footstep-resources.d.ts",
      "import": "./validators/footstep-resources.mjs"
    },
    "./schemas/oex-footstep-resources.json": "./schemas/oex-footstep-resources.json"
  },
  "types": "./types/index.d.ts",
  "bin": {
    "exhibitos-artwork": "validators/artwork-cli.mjs",
    "exhibitos-exhibition": "validators/exhibition-cli.mjs",
    "exhibitos-package": "validators/package-cli.mjs",
    "exhibitos-conformance": "conformance/cli.mjs"
  },
  "files": [
    "index.mjs",
    "types/",
    "schemas/",
    "validators/*.mjs",
    "!validators/*.test.mjs",
    "oes/",
    "oex/",
    "oed/",
    "fixtures/",
    "scripts/generate-fixtures.mjs",
    "LICENSES/",
    "LICENSE",
    "README.md",
    "conformance/runner.mjs",
    "conformance/cli.mjs",
    "docs/usage/cli.md",
    "providers/",
    "!providers/*.test.mjs"
  ]
}
