{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exhibitos.github.io/spec/providers/v1/1.0.0-draft.1/descriptor.schema.json",
  "title": "Optional provider descriptor 1.0.0-draft.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0-draft.1"
    },
    "kind": {
      "enum": [
        "auth-provider",
        "capture-producer"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{2,63}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "contract": {
      "enum": [
        "session-observation-v1",
        "oes-artwork-v1"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "version",
    "contract"
  ],
  "oneOf": [
    {
      "properties": {
        "kind": {
          "const": "auth-provider"
        },
        "contract": {
          "const": "session-observation-v1"
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "capture-producer"
        },
        "contract": {
          "const": "oes-artwork-v1"
        }
      }
    }
  ]
}
